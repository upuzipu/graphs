# Q6: Жанры конкретного фильма/сериала по названию

PREFIX movies: <http://example.org/movies#>
PREFIX id: <http://example.org/movies/id/>

SELECT ?title ?genreName ?imdbId
WHERE {
  { ?film a movies:Movie } UNION { ?film a movies:TVSeries }
  ?film movies:title ?title ;
        movies:hasGenre ?genre .
  ?genre movies:genreName ?genreName .
  OPTIONAL { ?film movies:imdbId ?imdbId . }
  FILTER(CONTAINS(LCASE(?title), "inception"))
}
