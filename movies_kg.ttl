@prefix : <http://example.org/movies#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:actedIn a owl:ObjectProperty ;
    rdfs:label "сыграл в"@ru ;
    rdfs:comment "Связь актера с фильмом/сериалом"@ru ;
    rdfs:domain :Actor ;
    rdfs:range :Work .

:awardName a owl:DatatypeProperty ;
    rdfs:label "название награды"@ru ;
    rdfs:domain :Award ;
    rdfs:range xsd:string .

:castOrder a owl:DatatypeProperty ;
    rdfs:label "порядок в титрах"@ru ;
    rdfs:range xsd:integer .

:characterName a owl:DatatypeProperty ;
    rdfs:label "имя персонажа"@ru ;
    rdfs:comment "Имя роли актера в данном фильме"@ru .

:directed a owl:ObjectProperty ;
    rdfs:label "снял"@ru ;
    rdfs:domain :Director ;
    rdfs:range :Work .

:genreName a owl:DatatypeProperty ;
    rdfs:label "название жанра"@ru ;
    rdfs:domain :Genre ;
    rdfs:range xsd:string .

:hasAward a owl:ObjectProperty ;
    rdfs:label "получил награду"@ru ;
    rdfs:domain :Work ;
    rdfs:range :Award .

:hasCastOrder a owl:ObjectProperty ;
    rdfs:label "порядок в титрах"@ru ;
    rdfs:comment "Позиция актера в титрах (для сортировки)"@ru .

:hasGenre a owl:ObjectProperty ;
    rdfs:label "принадлежит к жанру"@ru ;
    rdfs:domain :Work ;
    rdfs:range :Genre .

:imdbId a owl:DatatypeProperty ;
    rdfs:label "ID в IMDb (tconst)"@ru ;
    rdfs:comment "Идентификатор фильма/сериала в IMDb"@ru .

:imdbPersonId a owl:DatatypeProperty ;
    rdfs:label "ID персоны в IMDb (nconst)"@ru ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:originalTitle a owl:DatatypeProperty ;
    rdfs:label "оригинальное название"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:string .

:overview a owl:DatatypeProperty ;
    rdfs:label "описание"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:string .

:personName a owl:DatatypeProperty ;
    rdfs:label "имя"@ru ;
    rdfs:domain :Person ;
    rdfs:range xsd:string .

:popularity a owl:DatatypeProperty ;
    rdfs:label "популярность (TMDb)"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:decimal .

:releaseDate a owl:DatatypeProperty ;
    rdfs:label "дата выхода"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:date .

:title a owl:DatatypeProperty ;
    rdfs:label "название"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:string .

:tmdbId a owl:DatatypeProperty ;
    rdfs:label "ID в TMDb"@ru ;
    rdfs:comment "Внешний идентификатор для связи с API"@ru .

:tmdbPersonId a owl:DatatypeProperty ;
    rdfs:label "ID персоны в TMDb"@ru ;
    rdfs:domain :Person ;
    rdfs:range xsd:integer .

:userRating a owl:DatatypeProperty ;
    rdfs:label "моя оценка"@ru ;
    rdfs:comment "Оценка пользователя от 0 до 10"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:decimal .

:voteAverage a owl:DatatypeProperty ;
    rdfs:label "средний рейтинг TMDb"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:decimal .

:watched a owl:DatatypeProperty ;
    rdfs:label "просмотрено"@ru ;
    rdfs:domain :Work ;
    rdfs:range xsd:boolean .

